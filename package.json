{
  "title": "Oblique",
  "name": "oblique",
  "version": "16.0.0-rc.1",
  "type": "module",
  "license": "MIT",
  "organization": {
    "name": "Federal Office of Information Technology, Systems and Telecommunication FOITT",
    "url": "https://www.bit.admin.ch/"
  },
  "homepage": "https://oblique.bit.admin.ch",
  "author": "Oblique Team <oblique@bit.admin.ch>",
  "contributors": [
    "https://github.com/oblique-bit/oblique/graphs/contributors"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oblique-bit/oblique.git"
  },
  "workspaces": [
    "projects/cli",
    "projects/design-system",
    "projects/oblique",
    "projects/sds",
    "projects/sandbox",
    "projects/sandbox-ssr",
    "projects/service-navigation-web-component",
    "projects/toolchain"
  ],
  "scripts": {
    "lint": "tsx scripts/lint.ts && npm run lint --workspaces",
    "format": "tsx scripts/lint.ts --fix && npm run format --workspaces",
    "dependencies-update": "tsx scripts/dependencies-update.ts",
    "update-angular": "tsx scripts/update-angular.ts",
    "postinstall": "tsx scripts/sanitize-package-lock.ts",
    "hook-pre-commit": "npx lint-staged",
    "hook-commit-msg": "tsx scripts/husky/hook.commit-rules.ts",
    "hook-post-checkout": "tsx scripts/husky/install-dependencies.ts && tsx scripts/delete-tags.ts",
    "prepare": "husky",
    "release": "tsx scripts/release.ts"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "dependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@ngx-translate/core": "^18.0.0",
    "@popperjs/core": "^2.11.8",
    "@schematics/angular": "^22.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-cookie": "^3.0.8",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-builders/jest": "^22.0.1",
    "@angular-devkit/build-angular": "^22.0.4",
    "@angular-devkit/core": "^22.0.4",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.20.0",
    "angular-eslint": "^22.0.0",
    "chalk": "^4.1.2",
    "cssnano": "^7.1.9",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-sonar": "^0.2.16",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.15",
    "postcss-import": "^16.1.1",
    "prettier": "^3.8.4",
    "stylelint": "~16.26.1",
    "stylelint-config-prettier-scss": "~1.0.0",
    "stylelint-config-standard-scss": "~13.1.0",
    "stylelint-scss": "~6.14.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "~8.58.0"
  }
}
