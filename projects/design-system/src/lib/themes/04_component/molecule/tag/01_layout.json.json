{
  "ob": {
    "c": {
      "tag": {
        "token_family_docs": {
          "description": {
            "$type": "other",
            "$value": "Layout tokens for the Tag molecule — container, spacing, border-radius, and color."
          }
        },
        "container": {
          "spacing": {
            "gap": {
              "$type": "spacing",
              "$value": "{ob.s.dimension.dynamic.ui_scale.element.xl.px}",
              "$description": "Spacing between single tags "
            }
          }
        },
        "spacing": {
          "padding": {
            "vertical": {
              "$type": "spacing",
              "$value": "{ob.s.dimension.dynamic.ui_scale.element.xs.px}",
              "$description": "Top and bottom padding  – for medium size tags."
            },
            "horizontal": {
              "$type": "spacing",
              "$value": "{ob.s.dimension.dynamic.ui_scale.element.xl.px}",
              "$description": "Left and right padding  – for medium size tags."
            }
          },
          "gap": {
            "$type": "spacing",
            "$value": "{ob.s.dimension.dynamic.ui_scale.element.xs.px}",
            "$description": "Horizontal gap between icon and text label  – for medium size tags."
          }
        },
        "border_radius": {
          "default": {
            "$type": "borderRadius",
            "$value": "{ob.s.border_radius.rounded}",
            "$description": "Standard tags in Oblique."
          }
        },
        "color": {
          "fg": {
            "enabled": {
              "$type": "color",
              "$value": "{ob.s.color.neutral.foreground.contrast_high}"
            },
            "hover": {
              "$type": "color",
              "$value": "{ob.s.color.neutral.foreground.contrast_high}"
            },
            "focus": {
              "$type": "color",
              "$value": "{ob.s.color.neutral.foreground.contrast_high}"
            },
            "selected": {
              "$type": "color",
              "$value": "{ob.s.color.neutral.foreground.contrast_medium_inverse}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{ob.s.color.neutral.foreground.contrast_lowest}"
            }
          },
          "bg": {
            "enabled": {
              "$type": "color",
              "$value": "{ob.s.color.neutral.background.contrast_medium}"
            },
            "hover": {
              "$type": "color",
              "$value": "{ob.s.color.neutral.background.contrast_high}"
            },
            "focus": {
              "$type": "color",
              "$value": "{ob.s.color.neutral.background.contrast_medium}"
            },
            "selected": {
              "$type": "color",
              "$value": "{ob.s.color.neutral.background.contrast_high_inverse}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{ob.s.color.neutral.background.contrast_medium}"
            }
          }
        }
      }
    }
  }
}