          "fatal": {
            "bg": {
              "$type": "color",
              "$value": "{ob.p.color.red.100}"
            },
            "text": {
              "$type": "color",
              "$value": "{ob.p.color.cobalt.800}"
            },
            "status-icon": {
              "$type": "color",
