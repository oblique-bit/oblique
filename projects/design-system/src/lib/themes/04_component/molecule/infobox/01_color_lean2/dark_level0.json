                    "color": "{ob.p.color.cobalt.800}"
                  }
                }
              },
              "$type": "color",
              "$value": "{ob.p.color.orange.900}"
            },
            "text": {
              "$type": "color",
              "$value": "{ob.p.color.cobalt.100}"
            },
            "status-icon": {
              "$type": "color",
              "$value": "{ob.p.color.orange.200}"
