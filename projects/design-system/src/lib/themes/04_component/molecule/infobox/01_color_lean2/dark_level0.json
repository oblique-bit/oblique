{
  "ob": {
    "c": {
      "infobox": {
        "color": {
          "info": {
            "bg": {
              "$extensions": {
                "studio.tokens": {
                  "modify": {
                    "type": "mix",
                    "value": "0.4",
                    "space": "srgb",
                    "color": "{ob.p.color.cobalt.800}"
                  }
                }
              },
              "$type": "color",
              "$value": "{ob.p.color.blue.900}"
            },
            "text": {
              "$type": "color",
              "$value": "{ob.p.color.cobalt.100}"
            },
            "status-icon": {
              "$type": "color",
              "$value": "{ob.p.color.blue.200}"
            },
            "border": {
              "$type": "color",
              "$value": "{ob.p.color.blue.200}"
            }
          },
          "error": {
            "bg": {
              "$extensions": {
                "studio.tokens": {
                  "modify": {
                    "type": "mix",
                    "value": "0.4",
                    "space": "srgb",
                    "color": "{ob.p.color.cobalt.800}"
                  }
                }
              },
              "$type": "color",
              "$value": "{ob.p.color.red.900}"
            },
            "text": {
              "$type": "color",
              "$value": "{ob.p.color.cobalt.100}"
