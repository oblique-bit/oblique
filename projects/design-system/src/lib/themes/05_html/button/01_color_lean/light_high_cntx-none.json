{
  "ob": {
    "h": {
      "button": {
        "color": {
          "primary": {
            "fg": {
              "rest": {
                "$extensions": {
                  "com.figma.hiddenFromPublishing": false,
                  "com.figma.scopes": [
                    "ALL_FILLS",
                    "TEXT_FILL",
                    "SHAPE_FILL",
                    "FRAME_FILL",
                    "STROKE_COLOR"
                  ]
                },
                "$type": "color",
                "$value": "{ob.p.color.basic.white}"
              },
              "hover": {
                "$type": "color",
                "$value": "{ob.p.color.basic.white}"
              },
              "active": {
                "$type": "color",
                "$value": "{ob.p.color.basic.white}"
              }
            },
            "bg": {
              "rest": {
                "$type": "color",
                "$value": "{ob.p.color.steelblue.600}"
              },
              "hover": {
                "$extensions": {
                  "studio.tokens": {
                    "modify": {
                      "type": "mix",
                      "value": "{ob.s.state-layer.strong.hover}",
                      "space": "srgb",
                      "color": "{ob.p.color.cobalt.900}"
                    }
                  }
                },
                "$type": "color",
                "$value": "{ob.h.button.color.primary.bg.rest}"
              },
              "active": {
                "$extensions": {
                  "studio.tokens": {
                    "modify": {
                      "type": "mix",
                      "value": "{ob.s.state-layer.strong.active}",
