        "color": {
          "token_family_docs": {
            "$description": {
              "$type": "other",
              "$value": "Color tokens for the HTML button element. Resting colours come from the semantic tier, so lightness and emphasis resolve upstream and one file covers every combination. Hover and pressed are not separate resting colours: they are the resting colour composited with ob.s.color.interaction.overlay, which carries the direction, at a ratio from ob.s.modifier, which carries the amount. Primary has a solid base so its feedback is an opaque mix; secondary and tertiary are transparent so theirs is an alpha overlay. Disabled and the foreground are resting colours in their own right, not computed."
            }
          },
