{
  "ob": {
    "h": {
      "button": {
        "token_family_docs": {
          "description": {
            "$type": "other",
            "$value": "Layout tokens for the HTML button element: padding, gap, minimum height, icon size, border radius and border width. Restored from version 9.7."
          }
        },
        "dynamic": {
          "label_icon": {
            "spacing": {
              "padding": {
                "vertical": {
                  "$type": "spacing",
                  "$value": "{ob.s.dimension.dynamic.scale.element.sm.px}"
                },
                "horizontal": {
                  "$type": "spacing",
                  "$value": "{ob.s.dimension.dynamic.scale.element.xl.px}"
                }
              },
              "gap": {
                "$type": "spacing",
                "$value": "{ob.s.dimension.dynamic.scale.element.sm.px}"
              }
            },
            "container": {
              "size": {
                "min_height": {
                  "$type": "sizing",
                  "$value": "{ob.s.dimension.dynamic.scale.container.xs.px}",
                  "$description": "old {ob.s.dimension.dynamic.scale.spacing.md.px}\n"
                }
              }
            },
            "icon_size": {
              "$type": "sizing",
              "$value": "{ob.s.dimension.static.scale.spacing.md.px}",
              "$description": "Standard proportional size of the icon inside the label_icon button subcomponent."
            }
          },
          "icon_only": {
            "spacing": {
              "padding": {
                "vertical": {
                  "$type": "spacing",
                  "$value": "{ob.s.dimension.dynamic.scale.element.sm.px}"
                },
                "horizontal": {
                  "$type": "spacing",
                  "$value": "{ob.s.dimension.dynamic.scale.element.sm.px}"
                }
              }
            }
          },
          "remove": {
            "spacing": {
              "padding": {
                "vertical": {
                  "$type": "spacing",
                  "$value": "{ob.s.dimension.static.scale.none.px}",
                  "$description": "Remove button requires zero padding."
                },
                "horizontal": {
                  "$type": "spacing",
                  "$value": "{ob.s.dimension.static.scale.none.px}",
                  "$description": "Remove button requires zero padding."
                }
              }
            }
          },
          "icon": {
            "size": {
              "$type": "sizing",
              "$value": "{ob.s.dimension.static.scale.spacing.md.px}"
            }
          }
        },
        "remove": {
          "icon": {
            "asset": {
              "$type": "asset",
              "$value": "cancel-circle",
              "$description": "Default icon asset for button.remove."
            }
          }
        },
        "border_radius": {
          "$type": "borderRadius",
          "$value": "{ob.s.border_radius.md}",
          "$description": "Standard border radius for button components - consistent across all sizes"
        },
        "border_width": {
          "$type": "borderWidth",
          "$value": "{ob.s.border_width.xs}",
          "$description": "Tinest border width possible for buttons for aesthetics and functionality: differentiation between secondary and tertiary. Static token, not reacting on changing component-size modes."
        },
        "static": {
          "label_icon": {
            "spacing": {
              "padding": {
                "vertical": {
                  "$type": "spacing",
                  "$value": "{ob.s.dimension.static.scale.element.sm.px}"
                },
                "horizontal": {
                  "$type": "spacing",
                  "$value": "{ob.s.dimension.static.scale.element.xl.px}"
                }
              },
              "gap": {
                "$type": "spacing",
                "$value": "{ob.s.dimension.static.scale.element.sm.px}"
              }
            },
            "container": {
              "size": {
                "min_height": {
                  "$type": "sizing",
                  "$value": "{ob.s.dimension.static.scale.spacing.lg.px}",
                  "$description": "old {ob.s.dimension.dynamic.scale.spacing.md.px}\n"
                }
              }
            },
            "icon_size": {
              "$type": "sizing",
              "$value": "{ob.s.dimension.static.scale.spacing.md.px}",
              "$description": "Standard proportional size of the icon inside the label_icon button subcomponent."
            }
          },
          "icon_only": {
            "spacing": {
              "padding": {
                "vertical": {
                  "$type": "spacing",
                  "$value": "{ob.s.dimension.static.scale.element.sm.px}"
                },
                "horizontal": {
                  "$type": "spacing",
                  "$value": "{ob.s.dimension.static.scale.element.sm.px}"
                }
              }
            }
          },
          "remove": {
            "spacing": {
              "padding": {
                "vertical": {
                  "$type": "spacing",
                  "$value": "{ob.s.dimension.static.scale.none.px}",
                  "$description": "Remove button requires zero padding."
                },
                "horizontal": {
                  "$type": "spacing",
                  "$value": "{ob.s.dimension.static.scale.none.px}",
                  "$description": "Remove button requires zero padding."
                }
              }
            }
          },
          "icon": {
            "size": {
              "$type": "sizing",
              "$value": "{ob.s.dimension.static.scale.spacing.md.px}"
            }
          }
        },
        "container": {
          "gap": {
            "$type": "spacing",
            "$value": "{ob.s.dimension.static.scale.spacing.xs.px}",
            "$description": "Gap between the buttons in the button container, in both directions. Same on every viewport."
          }
        }
      }
    }
  }
}
