{
  "ob": {
    "s": {
      "typography": {
        "scale": {
          "dynamic": {
            "token_family_docs": {
              "description": {
                "$type": "other",
                "$value": "Individual typography tokens for the Small component size mode."
              }
            },
            "font_size": {
              "token_family_docs": {
                "description": {
                  "$type": "other",
                  "$value": "Dynamic font-size scale — values scale with the active ui_scale mode (sm/md/lg) via the typography multiplier."
                }
              },
              "xs": {
                "$type": "fontSizes",
                "$value": "roundTo({ob.p.font_size_unitless.100} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)"
              },
              "sm": {
                "$type": "fontSizes",
                "$value": "roundTo({ob.p.font_size_unitless.200} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)"
              },
              "md": {
                "$type": "fontSizes",
                "$value": "roundTo({ob.p.font_size_unitless.300} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)"
              },
              "lg": {
                "$type": "fontSizes",
                "$value": "roundTo({ob.p.font_size_unitless.400} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)"
              },
              "xl": {
                "$type": "fontSizes",
                "$value": "roundTo({ob.p.font_size_unitless.500} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)",
                "$description": "Inserted step — aligns H3 (interface context) with the current production font-size. Sits between lg and the renumbered 2xl."
              },
              "2xl": {
                "$type": "fontSizes",
                "$value": "roundTo({ob.p.font_size_unitless.600} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)"
              },
              "3xl": {
                "$type": "fontSizes",
                "$value": "roundTo({ob.p.font_size_unitless.700} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)"
              },
              "4xl": {
                "$type": "fontSizes",
                "$value": "roundTo({ob.p.font_size_unitless.800} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)"
              },
              "5xl": {
                "$type": "fontSizes",
                "$value": "roundTo({ob.p.font_size_unitless.900} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)"
              },
              "6xl": {
                "$type": "fontSizes",
                "$value": "roundTo({ob.p.font_size_unitless.1000} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)"
              },
              "base": {
                "$type": "fontSizes",
                "$value": "roundTo({ob.p.font_size_unitless.300} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)"
              }
            },
            "line_height": {
              "token_family_docs": {
                "description": {
                  "$type": "other",
                  "$value": "Dynamic line-height scale — paired with the dynamic font-size scale. Scales with ui_scale (sm/md/lg)."
                }
              },
              "xs": {
                "$type": "lineHeights",
                "$value": "roundTo({ob.p.line_height.300} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)"
              },
              "sm": {
                "$type": "lineHeights",
                "$value": "roundTo({ob.p.line_height.400} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)"
              },
              "md": {
                "$type": "lineHeights",
                "$value": "roundTo({ob.p.line_height.500} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)"
              },
              "lg": {
                "$type": "lineHeights",
                "$value": "roundTo({ob.p.line_height.600} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)"
              },
              "2xl": {
                "$type": "lineHeights",
                "$value": "roundTo({ob.p.line_height.800} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)"
              },
              "3xl": {
                "$type": "lineHeights",
                "$value": "roundTo({ob.p.line_height.1100} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)"
              },
              "4xl": {
                "$type": "lineHeights",
                "$value": "roundTo({ob.p.line_height.1300} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)"
              },
              "5xl": {
                "$type": "lineHeights",
                "$value": "roundTo({ob.p.line_height.1400} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}, 0)"
              }
            },
            "paragraph_spacing": {
              "token_family_docs": {
                "description": {
                  "$type": "other",
                  "$value": "Dynamic paragraph-spacing scale — half the matching dynamic line-height, so paragraph rhythm scales with ui_scale."
                }
              },
              "xs": {
                "$type": "paragraphSpacing",
                "$value": "roundTo(({ob.s.typography.scale.dynamic.line_height.xs} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}) / 2, 0)"
              },
              "sm": {
                "$type": "paragraphSpacing",
                "$value": "roundTo(({ob.s.typography.scale.dynamic.line_height.sm} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}) / 2, 0)"
              },
              "md": {
                "$type": "paragraphSpacing",
                "$value": "roundTo(({ob.s.typography.scale.dynamic.line_height.md} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}) / 2, 0)"
              },
              "lg": {
                "$type": "paragraphSpacing",
                "$value": "roundTo(({ob.s.typography.scale.dynamic.line_height.lg} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}) / 2, 0)"
              },
              "2xl": {
                "$type": "paragraphSpacing",
                "$value": "roundTo(({ob.s.typography.scale.dynamic.line_height.2xl} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}) / 2, 0)"
              },
              "3xl": {
                "$type": "paragraphSpacing",
                "$value": "roundTo(({ob.s.typography.scale.dynamic.line_height.3xl} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}) / 2, 0)"
              },
              "4xl": {
                "$type": "paragraphSpacing",
                "$value": "roundTo(({ob.s.typography.scale.dynamic.line_height.4xl} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}) / 2, 0)"
              },
              "5xl": {
                "$type": "paragraphSpacing",
                "$value": "roundTo(({ob.s.typography.scale.dynamic.line_height.5xl} * {ob.g.mode_collection.ui_scale.multiplier.typography.sm}) / 2, 0)"
              }
            },
            "spacing": {
              "heading": {
                "top": {
                  "$type": "spacing",
                  "$value": "{ob.s.dimension.static.ui_scale.none.px}",
                  "$description": "Standard spacing above H1 is none to use vertical space."
                },
                "top_after_p": {
                  "$type": "spacing",
                  "$value": "{ob.s.dimension.static.ui_scale.container.md.px}",
                  "$description": "SPecial spacing above H1 after a paragraph"
                },
                "bottom": {
                  "$type": "spacing",
                  "$value": "{ob.s.dimension.static.ui_scale.element.md.px}"
                }
              },
              "paragraph": {
                "bottom": {
                  "$type": "spacing",
                  "$value": "{ob.s.dimension.static.density.6xl.rem}"
                }
              }
            },
            "font_weight": {
              "token_family_docs": {
                "description": {
                  "$type": "other",
                  "$value": "Dynamic font weight tokens — identical numeric mapping to the static set, exposed in the ui_scale collection for parity."
                }
              },
              "regular": {
                "$type": "fontWeights",
                "$value": "{ob.p.font_weight.400}"
              },
              "medium": {
                "$type": "fontWeights",
                "$value": "{ob.p.font_weight.500}"
              },
              "semiBold": {
                "$type": "fontWeights",
                "$value": "{ob.p.font_weight.600}"
              },
              "bold": {
                "$type": "fontWeights",
                "$value": "{ob.p.font_weight.700}"
              },
              "extraBold": {
                "$type": "fontWeights",
                "$value": "{ob.p.font_weight.800}"
              }
            },
            "text_decoration": {
              "token_family_docs": {
                "description": {
                  "$type": "other",
                  "$value": "Dynamic text-decoration tokens — primarily for links. Mirrors the static set."
                }
              },
              "link": {
                "emphasis_high": {
                  "$type": "textDecoration",
                  "$value": "{ob.p.text_decoration.underline}",
                  "$description": "Standard text-link has an underline."
                },
                "emphasis_low": {
                  "$type": "textDecoration",
                  "$value": "{ob.p.text_decoration.none}",
                  "$description": "Use where it is obvious that it is link and no need for additional typographical emphasis such as underline."
                }
              }
            },
            "letter_spacing_rem": {
              "token_family_docs": {
                "description": {
                  "$type": "other",
                  "$value": "Dynamic letter spacing (rem) — tracking values authored in rem in the ui_scale collection."
                }
              },
              "superNarrow": {
                "$type": "letterSpacing",
                "$value": "-0.03rem",
                "$description": "For font sizes 4xl, 5xl, 6xl for a more compact visual appearance. \nHas to be convertered to em!"
              },
              "narrower": {
                "$type": "letterSpacing",
                "$value": "-0.01rem",
                "$description": "For font size 3x for a more compact visual appearance.\nHas to be convertered to em!"
              },
              "narrow": {
                "$type": "letterSpacing",
                "$value": "0.005rem",
                "$description": "For font sizes 2xl for a more compact visual appearance.\nHas to be convertered to em!\n"
              },
              "normal": {
                "$type": "letterSpacing",
                "$value": "auto",
                "$description": "Default letter spacing for body and labels.\nHas to be convertered to em!"
              },
              "wide": {
                "$type": "letterSpacing",
                "$value": "0.5%",
                "$description": "For buttons for a more confortable visual appearance\nHas to be convertered to em!"
              }
            },
            "letter_spacing_px": {
              "token_family_docs": {
                "description": {
                  "$type": "other",
                  "$value": "Dynamic letter spacing (px) — tracking values authored in px in the ui_scale collection."
                }
              },
              "superNarrow": {
                "$type": "letterSpacing",
                "$value": "{ob.p.letter_spacing_px.neg_150}",
                "$description": "For font sizes 4xl, 5xl, 6xl for a more compact visual appearance. \nHas to be convertered to em!"
              },
              "narrower": {
                "$type": "letterSpacing",
                "$value": "{ob.p.letter_spacing_px.neg_100}",
                "$description": "For font size 3x for a more compact visual appearance.\nHas to be convertered to em!"
              },
              "narrow": {
                "$type": "letterSpacing",
                "$value": "{ob.p.letter_spacing_px.neg_50}",
                "$description": "For font sizes 2xl for a more compact visual appearance.\nHas to be convertered to em!\n"
              },
              "normal": {
                "$type": "letterSpacing",
                "$value": "{ob.p.letter_spacing_px.0}",
                "$description": "Default letter spacing for body and labels.\nHas to be convertered to em!"
              },
              "wide": {
                "$type": "letterSpacing",
                "$value": "{ob.p.letter_spacing_px.50}",
                "$description": "For buttons for a more confortable visual appearance\nHas to be convertered to em!"
              }
            }
          }
        }
      }
    }
  }
}
