{
  "name": "@oblique/design-system",
  "version": "15.4.1",
  "type": "module",
  "scripts": {
    "lint": "tsx scripts/lint.ts",
    "format": "tsx scripts/lint.ts --fix",
    "test": "cd ../.. && ng test design-system",
    "test-ci": "cd ../.. && ng run design-system:test:ci",
    "build": "vite build && tsx scripts/post-build.ts",
    "release": "tsx scripts/release.ts",
    "extract-tokens": "node scripts/extract-tokens.mjs"
  },
  "peerDependencies": {
    "@angular/cdk": "^20.0.0 || ^21.0.0",
    "@angular/common": "^20.0.0 || ^21.0.0",
    "@angular/core": "^20.0.0 || ^21.0.0",
    "@angular/material": "^20.0.0 || ^21.0.0",
    "@ngx-translate/core": "^17.0.0"
  },
  "devDependencies": {
    "@tokens-studio/sd-transforms": "^2.0.3",
    "vite": "^7.3.5",
    "vite-plugin-dts": "^5.0.2"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./lib/index.d.ts"
    },
    "./lib/*": {
      "import": "./lib/*/index.js",
      "types": "./lib/*/index.d.ts"
    },
    "./oblique.css": {
      "style": "./css/oblique.css"
    },
    "./oblique.min.css": {
      "style": "./css/oblique.min.css"
    }
  }
}
