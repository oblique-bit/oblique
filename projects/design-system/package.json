{
  "name": "@oblique/design-system",
  "version": "16.0.0-alpha.4",
  "type": "module",
  "scripts": {
    "lint": "tsx scripts/lint.ts",
    "format": "tsx scripts/lint.ts --fix",
    "test": "vitest",
    "test-browser": "vitest --browser.headless=false",
    "test-ci": "vitest run --config vitest.config.ci.ts",
    "build": "vite build && tsx scripts/post-build.ts",
    "release": "tsx scripts/release.ts",
    "extract-tokens": "node scripts/extract-tokens.mjs"
  },
  "peerDependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@tokens-studio/sd-transforms": "^2.0.3",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "lit": "^3.3.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^5.0.3"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./lib/index.d.ts"
    },
    "./lib/*": {
      "import": "./lib/*/index.js",
      "types": "./lib/*/index.d.ts"
    },
    "./oblique.css": {
      "style": "./css/oblique.css"
    },
    "./oblique.min.css": {
      "style": "./css/oblique.min.css"
    }
  }
}
