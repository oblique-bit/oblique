{
  "name": "@oblique/toolchain",
  "version": "16.0.0-alpha.1",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Toolchain utilities for the Oblique ecosystem, including project configuration schematics, ESLint plugins, and supporting build scripts",
  "scripts": {
    "link": "npm run build && cd ../../dist/toolchain && npm link",
    "lint": "tsx scripts/lint.ts",
    "format": "npm run lint -- --fix",
    "test": "jest",
    "test-ci": "jest --config=jest.config.ci.js",
    "build": "tsx scripts/pre-build.ts && tsc -p tsconfig.lib.json && tsx scripts/post-build.ts",
    "release": "tsx scripts/release.ts",
    "npm-publish": "tsx scripts/publish.ts"
  },
  "keywords": [
    "schematics"
  ],
  "dependencies": {
    "chalk": "^4.1.2"
  },
  "exports": {
    "./eslint-config": "./linting/eslint-config-oblique.mjs",
    "./package.json": "./package.json",
    "./logger": {
      "types": "./logger/index.d.ts",
      "default": "./logger/index.js"
    },
    "./logger/mock": {
      "types": "./logger/mock/index.d.ts",
      "default": "./logger/mock/index.js"
    },
    "./exec": {
      "types": "./process/index.d.ts",
      "default": "./process/index.js"
    }
  },
  "schematics": "./schematics/collection.json",
  "ng-add": {
    "save": "devDependencies"
  }
}
