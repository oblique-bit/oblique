{
  "name": "@oblique/toolchain",
  "version": "16.0.0-alpha.4",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/oblique-bit/oblique.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "description": "Toolchain utilities for the Oblique ecosystem, including project configuration schematics, ESLint plugins, and supporting build scripts",
  "scripts": {
    "link": "npm run build && cd ../../dist/toolchain && npm link",
    "lint": "tsx scripts/pipelines/lint.ts",
    "format": "npm run lint -- --fix",
    "test": "jest",
    "test-ci": "jest --config=jest.config.ci.js",
    "build": "tsx scripts/pipelines/pre-build.ts && tsc -p tsconfig.lib.json && tsc -p tsconfig.esm.json && tsx scripts/pipelines/post-build.ts",
    "release": "tsx scripts/pipelines/release.ts",
    "npm-publish": "tsx scripts/pipelines/publish.ts"
  },
  "keywords": [
    "schematics"
  ],
  "dependencies": {
    "angular-eslint": "^22.0.0",
    "chalk": "^4.1.2",
    "jsonc-parser": "^3.3.1",
    "parse5": "^7.2.1"
  },
  "exports": {
    "./eslint-config": "./linting/eslint-config-oblique.mjs",
    "./package.json": "./package.json",
    "./logger": {
      "types": "./esm/logger/index.d.ts",
      "default": "./esm/logger/index.js"
    },
    "./logger/mock": {
      "types": "./esm/logger/mock/index.d.ts",
      "default": "./esm/logger/mock/index.js"
    },
    "./exec": {
      "types": "./esm/exec/index.d.ts",
      "default": "./esm/exec/index.js"
    }
  },
  "schematics": "./schematics/collection.json",
  "ng-add": {
    "save": "devDependencies"
  }
}
