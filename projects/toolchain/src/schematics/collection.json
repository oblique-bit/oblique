{
  "$schema": "../../../../node_modules/@angular-devkit/schematics/collection-schema.json",
  "schematics": {
    "add-oblique": {
      "description": "Embeds Oblique favicon into index.html",
      "factory": "./add-oblique/index#addOblique"
    },
    "ng-add": {
      "description": "Adds @oblique/toolchain dependency to the project",
      "factory": "./ng-add/index#toolchain",
      "schema": "./ng-add/schema.json"
    },
    "linting": {
      "description": "Configures project linting",
      "factory": "./linting/index#linting",
      "schema": "./linting/schema.json"
    },
    "i18n": {
      "description": "Configures project internationalization",
      "factory": "./i18n/index#i18n",
      "schema": "./i18n/schema.json"
    }
  }
}
