{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ObI18nSchema",
  "title": "Generate i18n setup",
  "type": "object",
  "properties": {
    "silent": {
      "type": "boolean",
      "default": false,
      "description": "Disable schematic logging"
    },
    "locales": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": ["de-CH", "fr-CH", "it-CH"],
      "description": "Supported locales",
      "x-prompt": {
        "type": "array",
        "message": "Choose the supported locales",
        "items": {
          "type": "string",
          "message": "Locale code (e.g. de-CH)"
        }
      }
    }
  }
}
