{
  "name": "@oblique/cli",
  "version": "16.0.0-rc.1",
  "type": "module",
  "description": "Command Line Interface to manage Oblique projects",
  "repository": {
    "type": "git",
    "url": "https://github.com/oblique-bit/oblique.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ob",
    "oblique",
    "cli",
    "npmtool"
  ],
  "bin": {
    "ob": "./src/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "link": "npm uninstall @oblique/cli -g && npm run build && cd ../../dist/cli && npm link",
    "lint": "tsx scripts/lint.ts",
    "format": "npm run lint -- --fix",
    "test": "jest",
    "test-ci": "jest --config=jest.config.ci.js",
    "build": "tsx scripts/pre-build.ts && tsc -p tsconfig.app.json && tsx scripts/post-build.ts",
    "release": "tsx scripts/pre-build.ts && tsx scripts/release.ts",
    "npm-publish": "tsx scripts/publish.ts"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "chalk": "^4.1.2",
    "semver": "^7.7.1"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0",
    "ts-jest": "^29.4.12"
  }
}
