{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": false
  },
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "oblique-styles": {
      "root": "",
      "sourceRoot": "projects/oblique/src/styles",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "projects/oblique/styles/css",
            "tsConfig": "projects/stylesBuilder/tsconfig.styles.json",
            "main": "projects/stylesBuilder/main.ts",
            "index": "projects/stylesBuilder/index.html",
            "styles": [
              {
                "input": "projects/oblique/src/styles/scss/oblique-core.scss",
                "inject": false
              },
              {
                "input": "projects/oblique/src/styles/scss/oblique-alert.scss",
                "inject": false
              },
              {
                "input": "projects/oblique/src/styles/scss/oblique-icons.scss",
                "inject": false
              },
              {
                "input": "projects/stylesBuilder/oblique-components.scss",
                "inject": false
              }
            ]
          }
        }
      }
    },
    "oblique": {
      "root": "projects/oblique",
      "sourceRoot": "projects/oblique/src",
      "projectType": "library",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "projects/oblique/tsconfig.lib.json",
            "project": "projects/oblique/ng-package.json"
          }
        },
        "test": {
          "builder": "@angular-builders/jest:run",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "max-workers": ["2"]
          },
          "configurations": {
            "default": {
              "config": "jest.config.js"
            },
            "ci": {
              "config": "jest.config.ci.js"
            }
          },
          "defaultConfiguration": "default"
        }
      }
    },
    "sandbox": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/sandbox",
      "sourceRoot": "projects/sandbox/src",
      "prefix": "sb",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "allowedCommonJsDependencies": ["ajv", "ajv-formats"],
            "outputPath": "dist/sandbox",
            "index": "projects/sandbox/src/index.html",
            "main": "projects/sandbox/src/main.ts",
            "tsConfig": "projects/sandbox/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/sandbox/src/assets",
                "output": "/assets"
              },
              {
                "glob": "**/*",
                "input": "projects/oblique/src/assets",
                "output": "/assets"
              },
              {
                "glob": "**/*",
                "input": "projects/oblique/src/styles/fonts",
                "output": "/assets/fonts"
              }
            ],
            "styles": [
              "projects/oblique/src/styles/scss/oblique-core.scss",
              "projects/oblique/src/styles/scss/oblique-icons.scss",
              "projects/oblique/src/styles/scss/oblique-alert.scss",
              "projects/sandbox/src/scss/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["projects/oblique/src/styles/scss/core", "projects/oblique/src/styles/scss/core/mixins"]
            },
            "scripts": ["projects/oblique/src/ob-features.js"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3mb",
                  "maximumError": "3mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kb",
                  "maximumError": "22kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/sandbox/src/environments/environment.ts",
                  "with": "projects/sandbox/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "pams": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "fileReplacements": [
                {
                  "replace": "projects/sandbox/src/environments/environment.ts",
                  "with": "projects/sandbox/src/environments/environment.pams.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 3001
          },
          "configurations": {
            "production": {
              "buildTarget": "sandbox:build:production"
            },
            "development": {
              "buildTarget": "sandbox:build:development"
            },
            "pams": {
              "buildTarget": "sandbox:build:pams",
              "port": 3000
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/sandbox/tsconfig.spec.json",
            "runner": "vitest",
            "setupFiles": ["tests/setupVitest.ts"],
            "coverage": true,
            "coverageReporters": ["text", "html", "lcov"],
            "coverageInclude": [
              "projects/sandbox/src/app/app.component.ts",
              "projects/sandbox/src/app/home/home.page.ts",
              "projects/sandbox/src/app/samples/breadcrumb/breadcrumb.component.ts",
              "projects/sandbox/src/app/samples/collapse/collapse-sample.component.ts",
              "projects/sandbox/src/app/samples/error-messages-sample/error-messages-sample.component.ts",
              "projects/sandbox/src/app/samples/master-layout/dynamic-navigation.service.ts",
              "projects/sandbox/src/app/samples/nav-tree/nav-tree-sample.component.ts",
              "projects/sandbox/src/app/samples/number-format/number-format-sample.component.ts",
              "projects/sandbox/src/app/samples/schema-validation/schema-validation-sample.component.ts"
            ],
            "coverageExclude": ["**/*.spec.ts", "projects/oblique/**"],
            "coverageThresholds": {
              "perFile": true,
              "lines": 100,
              "functions": 100,
              "branches": 90,
              "statements": 100
            }
          },
          "configurations": {
            "default": {
              "watch": true
            },
            "ci": {
              "watch": false,
              "reporters": [["junit", { "outputFile": "coverage/sandbox/sqr.xml" }]]
            }
          },
          "defaultConfiguration": "default"
        }
      }
    },
    "sds": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "prefix": "app",
          "standalone": true
        },
        "@schematics/angular:directive": {
          "prefix": "app",
          "standalone": true
        },
        "@schematics/angular:pipe": {
          "standalone": true
        }
      },
      "root": "projects/sds",
      "sourceRoot": "projects/sds/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "allowedCommonJsDependencies": ["ajv", "ajv-formats"],
            "outputPath": "dist/sds/public",
            "index": "projects/sds/src/index.html",
            "main": "projects/sds/src/main.ts",
            "polyfills": ["zone.js", "projects/sds/src/polyfills.ts"],
            "tsConfig": "projects/sds/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/sds/src/assets",
                "output": "/assets"
              },
              {
                "glob": "**/*",
                "input": "projects/oblique/src/assets",
                "output": "/assets"
              }
            ],
            "styles": [
              "projects/oblique/src/styles/scss/oblique-core.scss",
              "projects/sds/src/styles/styles.scss",
              "node_modules/highlight.js/styles/sunburst.css"
            ],
            "scripts": ["projects/oblique/src/ob-features.js", "node_modules/jquery/dist/jquery.js"]
          },
          "configurations": {
            "production": {
              "optimization": {
                "styles": {
                  "inlineCritical": false
                }
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3mb",
                  "maximumError": "3.5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kb",
                  "maximumError": "22kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 4200
          },
          "configurations": {
            "production": {
              "buildTarget": "sds:build:production"
            },
            "development": {
              "buildTarget": "sds:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/sds/tsconfig.spec.json",
            "runner": "vitest",
            "setupFiles": ["tests/setupVitest.ts"],
            "coverage": true,
            "coverageReporters": ["text", "html", "lcov"],
            "coverageInclude": ["projects/sds/src/app/**/*.ts"],
            "coverageExclude": ["**/*.spec.ts", "projects/oblique/**", "projects/sds/src/polyfills.ts"]
          },
          "configurations": {
            "default": {
              "watch": true
            },
            "ci": {
              "watch": false,
              "reporters": [["junit", { "outputFile": "coverage/sds/sqr.xml" }]]
            }
          },
          "defaultConfiguration": "default"
        }
      }
    },
    "service-navigation-web-component": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/service-navigation-web-component",
      "sourceRoot": "projects/service-navigation-web-component/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/service-navigation-web-component",
            "index": "projects/service-navigation-web-component/src/index.html",
            "main": "projects/service-navigation-web-component/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/service-navigation-web-component/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "package.json",
                "input": "projects/service-navigation-web-component/",
                "output": "./"
              },
              {
                "glob": "favicon.png",
                "input": "projects/oblique/src/assets/images",
                "output": "/assets/images"
              },
              "projects/service-navigation-web-component/src/assets"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "3mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kb",
                  "maximumError": "160kb"
                }
              ],
              "outputHashing": "none"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 3003
          },
          "configurations": {
            "production": {
              "buildTarget": "service-navigation-web-component:build:production"
            },
            "development": {
              "buildTarget": "service-navigation-web-component:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/service-navigation-web-component/tsconfig.spec.json",
            "runner": "vitest",
            "setupFiles": ["tests/setupVitest.ts"],
            "coverage": true,
            "coverageReporters": ["text", "html", "lcov"],
            "coverageThresholds": {
              "perFile": true,
              "lines": 100,
              "functions": 100,
              "branches": 100,
              "statements": 98
            },
            "coverageInclude": ["projects/service-navigation-web-component/src/app/**/*.ts"],
            "coverageExclude": ["**/*.spec.ts", "projects/service-navigation-web-component/src/app/**/*.model.ts"]
          },
          "configurations": {
            "default": {
              "watch": false
            },
            "ci": {
              "watch": false,
              "reporters": [["junit", { "outputFile": "coverage/service-navigation-web-component/sqr.xml" }]]
            }
          },
          "defaultConfiguration": "default"
        }
      }
    },
    "sandbox-ssr": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "prefix": "ssr"
        },
        "@schematics/angular:directive": {
          "prefix": "ssr"
        }
      },
      "root": "projects/sandbox-ssr",
      "sourceRoot": "projects/sandbox-ssr/src",
      "prefix": "ssr",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/sandbox-ssr",
            "index": "projects/sandbox-ssr/src/index.html",
            "browser": "projects/sandbox-ssr/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/sandbox-ssr/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/sandbox-ssr/src/assets",
              {
                "glob": "**/*",
                "input": "projects/oblique/src/assets",
                "output": "/assets"
              },
              {
                "glob": "**/*",
                "input": "projects/oblique/src/styles/fonts",
                "output": "/assets/fonts"
              }
            ],
            "scripts": ["projects/oblique/src/ob-features.js"],
            "server": "projects/sandbox-ssr/src/main.server.ts",
            "prerender": true,
            "ssr": {
              "entry": "projects/sandbox-ssr/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 3002
          },
          "configurations": {
            "production": {
              "buildTarget": "sandbox-ssr:build:production"
            },
            "development": {
              "buildTarget": "sandbox-ssr:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/sandbox-ssr/tsconfig.spec.json",
            "runner": "vitest",
            "setupFiles": ["tests/setupVitest.ts"],
            "coverage": true,
            "coverageReporters": ["text", "html", "lcov"],
            "coverageInclude": ["projects/sandbox-ssr/src/app/**/*.ts"],
            "coverageExclude": [
              "**/*.spec.ts",
              "projects/oblique/**",
              "**/multi-translate-loader*",
              "**/app.config.server.ts",
              "**/app.config.ts",
              "**/*.routes.ts"
            ]
          },
          "configurations": {
            "default": {
              "watch": true
            },
            "ci": {
              "watch": false,
              "reporters": [["junit", { "outputFile": "coverage/sandbox-ssr/sqr.xml" }]]
            }
          },
          "defaultConfiguration": "default"
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "skipTests": false,
      "inlineTemplate": false,
      "prefix": "ob",
      "style": "scss",
      "standalone": true,
      "type": "component"
    },
    "@schematics/angular:directive": {
      "prefix": "ob",
      "standalone": true,
      "type": "directive"
    },
    "@schematics/angular:pipe": {
      "standalone": true,
      "typeSeparator": "."
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
